{
  "$description": "Design tokens for AI Morning Brief — consume from TS as `import tokens from './design-tokens.json'`",
  "fonts": {
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,900;1,8..60,400;1,8..60,600;1,8..60,700;1,8..60,900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Serif+TC:wght@400;600;700;900&display=swap",
    "serif": "\"Source Serif 4\", \"Noto Serif TC\", \"PT Serif\", Georgia, serif",
    "sans": "\"Inter\", -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "themes": {
    "light": {
      "bg": "#F2EDE4",
      "bgDeep": "#E8E2D5",
      "card": "#FBF7EE",
      "cardEdge": "#1A1612",
      "ink": "#1A1612",
      "inkMuted": "#5A4F42",
      "inkFaint": "#8B7F6F",
      "rule": "#1A1612",
      "ruleSoft": "rgba(26,22,18,0.18)",
      "accent": "#C8321E",
      "accentSoft": "#E8BFB6",
      "positive": "#2D5A3D",
      "positiveSoft": "#C9DCC9",
      "negative": "#8B1A1A"
    },
    "dark": {
      "bg": "#14110D",
      "bgDeep": "#0D0B08",
      "card": "#1F1B15",
      "cardEdge": "#F2EDE4",
      "ink": "#F2EDE4",
      "inkMuted": "#9E9587",
      "inkFaint": "#6B6358",
      "rule": "#F2EDE4",
      "ruleSoft": "rgba(242,237,228,0.18)",
      "accent": "#E8654F",
      "accentSoft": "#5A2318",
      "positive": "#7FB57F",
      "positiveSoft": "#26402A",
      "negative": "#C54444"
    }
  },
  "accentPresets": {
    "red":    "#C8321E",
    "ink":    "#1A1612",
    "forest": "#2D5A3D",
    "navy":   "#1E3D8A",
    "ochre":  "#8A5A1E"
  },
  "currentUserConfig": {
    "theme": "dark",
    "accent": "#E8654F",
    "showQuiz": false,
    "density": "comfy"
  },
  "categoryTags": {
    "#model-release": { "fg": "#6B2E8A", "bg": "#EBDCF0" },
    "#api-platform":  { "fg": "#1E5A8A", "bg": "#D4E2EE" },
    "#infra":         { "fg": "#2D5A3D", "bg": "#D4E2D4" },
    "#tooling":       { "fg": "#8A5A1E", "bg": "#EEE0D4" },
    "#eval":          { "fg": "#6B1E3D", "bg": "#EED4DC" },
    "#agent":         { "fg": "#1E3D8A", "bg": "#D4D8EE" },
    "#policy":        { "fg": "#5A2D1E", "bg": "#EED8D4" },
    "#market":        { "fg": "#2D2D2D", "bg": "#E0DCD4" },
    "#opinion":       { "fg": "#5A5A2D", "bg": "#EAE8D4" },
    "#research":      { "fg": "#3D5A6B", "bg": "#D4E0E6" }
  },
  "spacing": {
    "cardHorizontalPadding": 24,
    "cardSectionGap": 14,
    "borderRadius": 2,
    "hairline": 1,
    "heavyRule": 1.5,
    "swipeThresholdPx": 90,
    "swipeRotationCoeff": 0.04
  },
  "typography": {
    "cardTitle":       { "font": "serif", "size": 30, "lineHeight": 1.12, "weight": 700, "letterSpacing": -0.3 },
    "cardSummary":     { "font": "serif", "size": 17, "lineHeight": 1.42, "weight": 400, "italic": true },
    "contextBody":     { "font": "sans",  "size": 14, "lineHeight": 1.55, "weight": 400 },
    "overlineMono":    { "font": "mono",  "size": 9,  "weight": 600, "letterSpacing": 1.5, "uppercase": true },
    "mastheadTitle":   { "font": "serif", "size": 18, "weight": 900, "italic": true, "letterSpacing": -0.3 },
    "impactBody":      { "font": "sans",  "size": 14, "lineHeight": 1.5, "weight": 500 },
    "buttonLabel":     { "font": "mono",  "size": 11, "weight": 600, "letterSpacing": 0.5, "uppercase": true },
    "celebrationHero": { "font": "serif", "size": 40, "lineHeight": 1.02, "weight": 900, "italic": true, "letterSpacing": -0.8 },
    "streakNumber":    { "font": "serif", "size": 48, "weight": 900 },
    "quizQuestion":    { "font": "serif", "size": 22, "lineHeight": 1.25, "weight": 700 }
  },
  "gestures": {
    "swipeThresholdPx": 90,
    "swipeRotationCoeff": 0.04,
    "flyAwayDurationMs": 220,
    "flyAwayDistancePx": 400,
    "flyAwayRotationDeg": 15,
    "sheetTransitionMs": 300,
    "sheetEasing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "sheetHeightPct": 78
  }
}
