{
  "name": "ai-morning-brief",
  "version": "1.0.0",
  "description": "Daily automated AI tech brief: RSS → LLM analysis → Turso DB → PWA + Web Push",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "start:quiz": "node dist/quiz-pipeline.js",
    "start:reminder": "node dist/reminder.js",
    "dev:pipeline": "tsx src/index.ts",
    "dev:quiz": "tsx src/quiz-pipeline.ts",
    "dev:reminder": "tsx src/reminder.ts",
    "dev:web": "cd web && npm run dev",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@libsql/client": "^0.17.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "openai": "^4.86.0",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
